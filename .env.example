# ---------------------------------------------------------------------------
# DevFlow environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#
# Read by prisma.config.ts for CLI commands (migrate, generate, seed) and by
# src/lib/db.ts for the runtime driver adapter. Prisma 7 no longer stores this
# in schema.prisma.
#
# Easiest local setup — no credentials to manage. Start a local Postgres with:
#   npx prisma dev devflow -d
# then copy the connection string it prints, replacing the database name with
# "devflow":
#   postgres://postgres:postgres@localhost:PORT/devflow?sslmode=disable\n#     &connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0\n#     &pool_timeout=0&socket_timeout=0
#
# Keep those pool parameters — `prisma dev` closes idle connections without
# them, and the next query fails with ConnectionClosed.
#
# Or point at your own PostgreSQL install:
#   postgresql://USER:PASSWORD@HOST:5432/devflow?schema=public
# Percent-encode any @ : / # ? % or space in the password.
DATABASE_URL=

# Secret used by Auth.js to sign and encrypt session tokens.
# Generate one with: npx auth secret
AUTH_SECRET=

# GitHub OAuth application credentials.
# Create at: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL (development):
#   http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
