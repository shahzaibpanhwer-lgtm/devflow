# ---------------------------------------------------------------------------
# DevFlow environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#
# Read by prisma.config.ts for CLI commands (migrate, generate, seed) and by
# src/lib/db.ts for the runtime driver adapter. Prisma 7 no longer stores this
# in schema.prisma.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local example: postgresql://postgres:yourpassword@localhost:5432/devflow?schema=public
DATABASE_URL=

# Secret used by Auth.js to sign and encrypt session tokens.
# Generate one with: npx auth secret
AUTH_SECRET=

# GitHub OAuth application credentials.
# Create at: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL (development):
#   http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
