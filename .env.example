# ---------------------------------------------------------------------------
# DevFlow environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#
# Read by prisma.config.ts for CLI commands (migrate, generate, seed) and by
# src/lib/db.ts for the runtime driver adapter. Prisma 7 no longer stores this
# in schema.prisma.
#
# Easiest local setup — no credentials to manage. Start a local Postgres with:
#   npm run db:start
# It prints several connection strings; take the plain `postgres://` one (the
# TCP entry, not the `prisma+postgres://` one) and replace the database name
# with "devflow":
#   postgres://postgres:postgres@localhost:PORT/devflow?sslmode=disable
#
# Or point at your own PostgreSQL install:
#   postgresql://USER:PASSWORD@HOST:5432/devflow?schema=public
# Percent-encode any @ : / # ? % or space in the password.
DATABASE_URL=

# Secret used by Auth.js to sign and encrypt session tokens.
# Generate one with: npx auth secret
AUTH_SECRET=

# GitHub OAuth application credentials.
# Create at: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL (development):
#   http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Connection pool tuning (optional)
# ---------------------------------------------------------------------------
# Leave these unset unless you have measured a reason not to. The defaults
# (max 10, 30s idle, 15s to acquire) suit both a hosted Postgres and the local
# `prisma dev` server.
#
# They are overridable because hosted providers differ: a plan with a low
# connection ceiling, or a pooler that hangs up sooner than 30 seconds, may
# want smaller numbers.
#
# One warning from having tried it: shrinking the idle timeout to "reconnect
# more often" makes things worse, not better. Measured against a local
# Postgres under concurrent load, dropping it from 30s to 1s doubled the
# failure rate, because the pool spent its time replacing connections it had
# just discarded. Stale connections are handled by the retry layer in
# src/lib/db.ts instead.
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_TIMEOUT_MS=
DATABASE_POOL_CONNECTION_TIMEOUT_MS=
